# Copia questo file in deploy.conf e riempi SG_UTENTE. deploy.conf non entra
# in git: questo repo e' pubblico, e l'utente SSH dell'hosting non ci va.
#
# L'utente si legge in SiteGround, Site Tools > Devs > SSH Keys Manager, dove
# si importa anche la chiave pubblica.

SG_UTENTE=
SG_HOST=ssh.ai-make.it
SG_PORTA=18765
SG_CHIAVE=$HOME/.ssh/siteground-ai-make-it
SG_REMOTO=www/ai-make.it/public_html/dizionario
